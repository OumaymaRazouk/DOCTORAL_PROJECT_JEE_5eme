enum SoutenanceStatus {
  BROUILLON
  SOUMIS
  PREREQUIS_EN_VERIFICATION
  PREREQUIS_VALIDES
  JURY_PROPOSE
  JURY_VALIDE
  SOUTENANCE_AUTORISEE
  PLANIFICATION_PROPOSEE
  SOUTENANCE_PLANIFIEE
  SOUTENANCE_EFFECTUEE
  REJETE
}

enum JuryRole {
  RAPPORTEUR
  EXAMINATEUR
  PRESIDENT
  INVITE
}

type JuryMember {
  id: ID!
  nom: String!
  prenom: String!
  affiliation: String!
  email: String!
  telephone: String
  role: JuryRole!
}

type Soutenance {
  id: ID!
  doctorantId: ID!
  directeurId: ID!
  status: SoutenanceStatus!

  titreTheseDefinitif: String
  resumeFinal: String
  motsCles: [String!]

  manuscritPath: String
  rapportThesePath: String
  rapportAntiPlagiatPath: String
  preuvesPublicationsPath: String
  preuvesCommunicationsPath: String
  attestationsFormationsPath: String
  demandeManuscritePath: String

  commentairePrerequis: String
  commentaireJury: String
  motifRejet: String

  dateSoumission: String
  dateAutorisation: String
  datePlanifiee: String
  salle: String
  lieu: String
  lienVisioconference: String

  jury: [JuryMember!]!
}

input SoutenanceDraftInput {
  doctorantId: ID!
  directeurId: ID!
  titreTheseDefinitif: String!
  resumeFinal: String!
  motsCles: [String!]!
  manuscritPath: String
  rapportThesePath: String
  rapportAntiPlagiatPath: String
  preuvesPublicationsPath: String
  preuvesCommunicationsPath: String
  attestationsFormationsPath: String
  demandeManuscritePath: String
}

enum PrerequisDossierEtat {
  EN_ATTENTE
  VALIDE
  REFUSE
}

type PrerequisDossier {
  doctorantId: ID!
  publicationsCount: Int!
  communicationsCount: Int!
  heuresFormationCumulees: Int!
  dureeDoctoratAnnees: Int!

  etatScientifique: PrerequisDossierEtat!
  commentaireScientifique: String
  dateValidationScientifique: String

  etatAdministratif: PrerequisDossierEtat!
  commentaireAdministratif: String
  dateValidationAdministratif: String

  createdAt: String
  updatedAt: String
}

input PrerequisDossierInput {
  doctorantId: ID!
  publicationsCount: Int!
  communicationsCount: Int!
  heuresFormationCumulees: Int!
  dureeDoctoratAnnees: Int!
}

input JuryMemberInput {
  nom: String!
  prenom: String!
  affiliation: String!
  email: String!
  telephone: String
  role: JuryRole!
}

input PlanificationInput {
  dateHeure: String!
  salle: String!
  lieu: String!
  lienVisioconference: String
}

type PrerequisSoutenanceConfig {
  doctorantId: ID!
  minPublications: Int!
  minCommunications: Int!
  minHeuresFormation: Int!
  maxDureeAnnees: Int!
  requireManuscrit: Boolean!
  requireAntiPlagiat: Boolean!
  requireAttestations: Boolean!
  requireDemandeManuscrite: Boolean!
}

input PrerequisConfigInput {
  doctorantId: ID!
  minPublications: Int!
  minCommunications: Int!
  minHeuresFormation: Int!
  maxDureeAnnees: Int!
  requireManuscrit: Boolean!
  requireAntiPlagiat: Boolean!
  requireAttestations: Boolean!
  requireDemandeManuscrite: Boolean!
}

type Query {
  soutenanceById(id: ID!): Soutenance
  soutenancesForDoctorant(doctorantId: ID!): [Soutenance!]!
  soutenancesForDirecteur(directeurId: ID!): [Soutenance!]!
  soutenancesForAdmin(status: SoutenanceStatus): [Soutenance!]!
  juryForSoutenance(soutenanceId: String!): [JuryMember!]!
  prerequisDossierForDoctorant(doctorantId: ID!): PrerequisDossier
  prerequisDossiersPendingScientifique: [PrerequisDossier!]!
  prerequisDossiersPendingAdministratif: [PrerequisDossier!]!
  prerequisConfigForDoctorant(doctorantId: ID!): PrerequisSoutenanceConfig
}

type Mutation {
  saveSoutenanceDraft(input: SoutenanceDraftInput!): Soutenance!
  submitSoutenance(id: ID!): Soutenance!
  deleteSoutenanceDraft(id: ID!): Boolean!

  adminMarkPrerequisUnderReview(id: ID!): Soutenance!
  adminValidatePrerequis(id: ID!, commentaire: String): Soutenance!
  adminRejectSoutenance(id: ID!, motif: String!): Soutenance!

  directeurProposeJury(id: ID!, membres: [JuryMemberInput!]!): Soutenance!
  adminValidateJury(id: ID!, commentaire: String): Soutenance!

  adminAuthorizeSoutenance(id: ID!): Soutenance!
  directeurProposePlanification(id: ID!, input: PlanificationInput!): Soutenance!
  adminPlanifySoutenance(id: ID!, input: PlanificationInput!): Soutenance!
  adminMarkSoutenanceDone(id: ID!, dateEffective: String): Soutenance!

   savePrerequisDossier(input: PrerequisDossierInput!): PrerequisDossier!
   directeurValidePrerequisDossier(doctorantId: ID!, valide: Boolean!, commentaire: String): PrerequisDossier!
   adminValidePrerequisDossier(doctorantId: ID!, valide: Boolean!, commentaire: String): PrerequisDossier!
  savePrerequisConfig(input: PrerequisConfigInput!): PrerequisSoutenanceConfig!
}

type Subscription {
  soutenanceUpdated(id: ID!): Soutenance!
}
